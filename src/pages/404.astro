---
import BaseLayout from "../layouts/BaseLayout.astro";
import BrandMark from "../components/BrandMark.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { siteCopy } from "../data/site";

const text = siteCopy.en;
---

<BaseLayout
  locale="en"
  alternateLocale="zh"
  alternateHref="/zh/"
  title="Not found · Vibe AGI"
  description={text.notFoundBody}
  pageClass="not-found-page"
  indexable={false}
>
  <SiteHeader locale="en" alternateHref="/zh/" />
  <main id="content" class="not-found">
    <div class="not-found__signal" aria-hidden="true">
      <span></span><BrandMark /><i></i>
    </div>
    <p class="eyebrow">HTTP / 404</p>
    <h1>{text.notFoundTitle}</h1>
    <p>{text.notFoundBody}</p>
    <p lang="zh-CN">这条信号没有连接到任何地方。</p>
    <a class="button" href="/">{text.notFoundAction}<span aria-hidden="true">→</span></a>
  </main>
  <SiteFooter locale="en" />
</BaseLayout>

<style>
  .not-found {
    display: grid;
    min-height: calc(100svh - 4.8rem);
    place-content: center;
    justify-items: center;
    padding: 5rem 1.5rem;
    text-align: center;
  }

  .not-found__signal {
    display: flex;
    width: min(34rem, 82vw);
    align-items: center;
    margin-bottom: 3rem;
  }

  .not-found__signal span {
    height: 2px;
    flex: 1;
    background: var(--ink);
  }

  .not-found__signal i {
    width: 35%;
    border-top: 2px dashed var(--coral);
  }

  h1 {
    max-width: 11ch;
    margin: 1rem 0;
    font-family: var(--font-display);
    font-size: clamp(3.5rem, 9vw, 7rem);
    font-weight: 610;
    letter-spacing: -0.06em;
    line-height: 0.88;
  }

  main > p:not(.eyebrow) {
    max-width: 34rem;
    margin: 0.25rem 0;
    color: var(--ink-soft);
    font-size: 1.05rem;
  }

  .button {
    margin-top: 2rem;
  }
</style>
