---
import BaseLayout from "../layouts/BaseLayout.astro";
import MatrixField from "./MatrixField.astro";
import ProductGlyph from "./ProductGlyph.astro";
import SiteFooter from "./SiteFooter.astro";
import SiteHeader from "./SiteHeader.astro";
import { productHref, products, type Locale } from "../data/products";
import { siteCopy } from "../data/site";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const text = siteCopy[locale];
const isChinese = locale === "zh";
const alternateHref = isChinese ? "/" : "/zh/";
const title = isChinese
  ? "Vibe AGI — 面向 AI 开发者与团队的独立工具"
  : "Vibe AGI — Independent tools for AI developers and teams";
const description = text.heroBody;
const siteUrl = new URL("/", Astro.site).href;
const organizationId = `${siteUrl}#organization`;
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": organizationId,
      name: "Vibe AGI",
      url: siteUrl,
      description: siteCopy.en.heroBody,
      sameAs: ["https://github.com/vibe-agi"],
    },
    {
      "@type": "WebSite",
      "@id": `${siteUrl}#website`,
      url: siteUrl,
      name: "Vibe AGI",
      alternateName: "Vibe AGI Open Product Studio",
      description: siteCopy.en.heroBody,
      inLanguage: ["en", "zh-CN"],
      publisher: { "@id": organizationId },
    },
  ],
};
---

<BaseLayout
  locale={locale}
  alternateLocale={isChinese ? "en" : "zh"}
  alternateHref={alternateHref}
  title={title}
  description={description}
  pageClass="home-page"
  structuredData={structuredData}
>
  <SiteHeader locale={locale} alternateHref={alternateHref} />
  <main id="content">
    <section class="hero-stage">
      <MatrixField />
      <div class="hero shell">
        <div class="hero__copy">
          <p class="eyebrow">{text.heroEyebrow}</p>
          <h1>
            <span>{text.heroTitleLead}</span>
            <em>{text.heroTitleAccent}</em>
          </h1>
          <p class="hero__body">{text.heroBody}</p>
          <div class="hero__actions">
            <a class="button" href="#products">
              {text.heroPrimary}<span class="button__arrow" aria-hidden="true">↓</span>
            </a>
            <a class="button button--secondary" href="https://github.com/vibe-agi">
              {text.heroSecondary}<span class="button__arrow" aria-hidden="true">↗</span>
            </a>
          </div>
          <p class="hero__proof"><span aria-hidden="true"></span>{text.heroProof}</p>
        </div>

        <div class="product-switcher" id="products" aria-label={text.productsTitle}>
          <div class="product-switcher__heading">
            <span>{text.productsEyebrow}</span>
            <span>02 / 02</span>
          </div>
          {
            products.map((product) => (
              <a
                class:list={["product-choice", `tone-${product.tone}`]}
                href={productHref(product, locale)}
              >
                <div class="product-choice__topline">
                  <span>{product.index}</span>
                  <span>{text.productIndependent}</span>
                </div>
                <div class="product-choice__identity">
                  <ProductGlyph product={product.slug} size="large" />
                  <div>
                    <h2>{product.name}</h2>
                    <p>{product.role[locale]}</p>
                  </div>
                </div>
                <p class="product-choice__summary">{product.summary[locale]}</p>
                <div class="product-choice__footer">
                  <span>{product.status[locale]}</span>
                  <strong>{text.productAction} <i aria-hidden="true">↗</i></strong>
                </div>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <section class="independence-section">
      <div class="shell independence-section__grid">
        <div>
          <p class="eyebrow">{text.productsEyebrow}</p>
          <h2>{text.productsTitle}</h2>
        </div>
        <p>{text.productsBody}</p>
      </div>
    </section>

    <section class="principles-section" id="principles">
      <div class="shell">
        <div class="section-heading">
          <div>
            <p class="eyebrow">{text.principlesEyebrow}</p>
            <h2>{text.principlesTitle}</h2>
          </div>
          <p>{text.principlesBody}</p>
        </div>
        <div class="principles-grid">
          {
            text.principles.map((principle, index) => (
              <article>
                <span class="principle-number">0{index + 1}</span>
                <p class="principle-label">{principle.label}</p>
                <h3>{principle.title}</h3>
                <p>{principle.body}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="closing-section">
      <div class="closing-section__inner shell">
        <div>
          <p class="eyebrow">{text.closingEyebrow}</p>
          <h2>{text.closingTitle}</h2>
        </div>
        <div class="closing-section__body">
          <p>{text.closingBody}</p>
          <a class="button closing-section__button" href="https://github.com/vibe-agi">
            {text.closingAction}<span class="button__arrow" aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </section>
  </main>
  <SiteFooter locale={locale} />
</BaseLayout>

<style>
  .hero-stage {
    position: relative;
    overflow: hidden;
    color: var(--paper);
    background: var(--matrix);
  }

  .hero {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: minmax(24rem, 1fr) minmax(24rem, 0.88fr);
    align-items: center;
    gap: clamp(3rem, 7vw, 7rem);
    min-height: calc(100svh - 4.8rem);
    padding-block: clamp(3.5rem, 7vw, 6rem);
  }

  .hero > * {
    min-width: 0;
  }

  .hero__copy {
    min-width: 0;
  }

  .hero .eyebrow {
    color: color-mix(in srgb, var(--vibermate-blue) 82%, var(--paper));
  }

  h1 {
    max-width: 10ch;
    margin: 1.2rem 0 1.7rem;
    font-family: var(--font-display);
    font-size: clamp(4rem, 7.3vw, 7.2rem);
    font-weight: 610;
    letter-spacing: -0.065em;
    line-height: 0.84;
  }

  h1 span,
  h1 em {
    display: block;
  }

  h1 em {
    margin-top: 0.18em;
    color: transparent;
    -webkit-text-stroke: 1.35px var(--paper);
    font-style: normal;
  }

  .hero__body {
    max-width: 38rem;
    margin: 0;
    color: color-mix(in srgb, var(--paper) 72%, transparent);
    font-size: clamp(1.05rem, 1.5vw, 1.22rem);
    line-height: 1.65;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 2.1rem;
  }

  .hero .button {
    border-color: var(--paper);
    color: var(--matrix);
    background: var(--paper);
  }

  .hero .button--secondary {
    border-color: color-mix(in srgb, var(--paper) 38%, transparent);
    color: var(--paper);
    background: color-mix(in srgb, var(--matrix) 74%, transparent);
  }

  .hero .button--secondary:hover {
    border-color: var(--paper);
    color: var(--matrix);
    background: var(--paper);
  }

  .hero__proof {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    margin: 1.35rem 0 0;
    color: color-mix(in srgb, var(--paper) 52%, transparent);
    font-family: var(--font-mono);
    font-size: 0.65rem;
  }

  .hero__proof span {
    width: 0.5rem;
    height: 0.5rem;
    border: 1px solid var(--vibermate-blue);
    border-radius: 50%;
  }

  .product-switcher {
    width: 100%;
    min-width: 0;
    border: 1px solid color-mix(in srgb, var(--paper) 18%, transparent);
    border-radius: 1rem;
    background: color-mix(in srgb, var(--matrix) 82%, transparent);
    box-shadow: 0 28px 80px rgba(0, 0, 0, 0.28);
    backdrop-filter: blur(15px);
  }

  .product-switcher__heading,
  .product-choice__topline,
  .product-choice__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    font-family: var(--font-mono);
  }

  .product-switcher__heading {
    min-height: 2.8rem;
    padding: 0 1rem;
    border-bottom: 1px solid color-mix(in srgb, var(--paper) 13%, transparent);
    color: color-mix(in srgb, var(--paper) 45%, transparent);
    font-size: 0.58rem;
    letter-spacing: 0.09em;
  }

  .product-choice {
    --tone: var(--vibermate-blue);
    position: relative;
    display: block;
    padding: 1.25rem 1.25rem 1.15rem;
    border-bottom: 1px solid color-mix(in srgb, var(--paper) 13%, transparent);
    color: var(--paper);
    text-decoration: none;
    transition: background 180ms ease;
  }

  .product-choice:last-child {
    border-bottom: 0;
  }

  .product-choice::before {
    position: absolute;
    top: 1rem;
    bottom: 1rem;
    left: -1px;
    width: 3px;
    border-radius: 0 2px 2px 0;
    background: var(--tone);
    content: "";
    opacity: 0.55;
    transform: scaleY(0.35);
    transition: opacity 180ms ease, transform 180ms ease;
  }

  .product-choice:hover,
  .product-choice:focus-visible {
    background: color-mix(in srgb, var(--tone) 10%, transparent);
  }

  .product-choice:hover::before,
  .product-choice:focus-visible::before {
    opacity: 1;
    transform: scaleY(1);
  }

  .product-choice__topline {
    color: color-mix(in srgb, var(--paper) 42%, transparent);
    font-size: 0.56rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .product-choice__topline span:last-child {
    color: var(--tone);
  }

  .product-choice__identity {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 0.8rem;
    color: var(--tone);
  }

  .product-choice__identity > div {
    min-width: 0;
  }

  .product-choice__identity h2,
  .product-choice__identity p,
  .product-choice__summary,
  .product-choice__footer {
    margin: 0;
  }

  .product-choice__identity h2 {
    color: var(--paper);
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 640;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .product-choice__identity p {
    margin-top: 0.25rem;
    color: color-mix(in srgb, var(--paper) 55%, transparent);
    font-size: 0.74rem;
  }

  .product-choice__summary {
    margin-top: 0.9rem;
    color: color-mix(in srgb, var(--paper) 72%, transparent);
    font-size: 0.91rem;
    line-height: 1.5;
  }

  .product-choice__footer {
    margin-top: 1rem;
    color: color-mix(in srgb, var(--paper) 43%, transparent);
    font-size: 0.57rem;
  }

  .product-choice__footer strong {
    color: var(--paper);
    font-family: var(--font-body);
    font-size: 0.78rem;
  }

  .product-choice__footer i {
    display: inline-block;
    margin-left: 0.22rem;
    font-style: normal;
    transition: transform 160ms ease;
  }

  .product-choice:hover .product-choice__footer i {
    transform: translate(2px, -2px);
  }

  .independence-section,
  .principles-section {
    padding-block: clamp(6rem, 11vw, 9rem);
  }

  .independence-section {
    border-bottom: 1px solid var(--line);
    background: color-mix(in srgb, var(--surface) 88%, transparent);
  }

  .independence-section__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(18rem, 0.8fr);
    align-items: end;
    gap: 4rem;
  }

  .independence-section h2 {
    max-width: 11ch;
    margin: 0.9rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(3rem, 6vw, 5.5rem);
    font-weight: 620;
    letter-spacing: -0.055em;
    line-height: 0.92;
  }

  .independence-section__grid > p {
    margin: 0;
    color: var(--ink-soft);
    font-size: clamp(1.05rem, 1.7vw, 1.24rem);
    line-height: 1.65;
  }

  .principles-section {
    background: var(--paper);
  }

  .principles-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--line-strong);
  }

  .principles-grid article {
    min-height: 24rem;
    padding: 1.5rem 2rem 2.5rem;
    border-right: 1px solid var(--line-strong);
  }

  .principles-grid article:first-child {
    border-left: 1px solid var(--line-strong);
  }

  .principle-number,
  .principle-label {
    font-family: var(--font-mono);
    font-size: 0.65rem;
  }

  .principle-number {
    display: block;
    color: var(--ink-faint);
  }

  .principle-label {
    margin: 5rem 0 0.8rem;
    color: var(--ink-soft);
    letter-spacing: 0.08em;
  }

  .principles-grid h3 {
    max-width: 12ch;
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 3vw, 2.7rem);
    font-weight: 610;
    letter-spacing: -0.045em;
    line-height: 1;
  }

  .principles-grid article > p:last-child {
    margin: 1.5rem 0 0;
    color: var(--ink-soft);
    line-height: 1.65;
  }

  .closing-section {
    overflow: hidden;
    padding-block: clamp(6rem, 12vw, 10rem);
    color: var(--paper);
    background: var(--ink);
  }

  .closing-section__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(18rem, 0.8fr);
    align-items: end;
    gap: 4rem;
  }

  .closing-section .eyebrow {
    color: color-mix(in srgb, var(--paper) 62%, transparent);
  }

  .closing-section h2 {
    max-width: 13ch;
    margin: 1rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(3.3rem, 7vw, 6.7rem);
    font-weight: 610;
    letter-spacing: -0.06em;
    line-height: 0.9;
  }

  .closing-section__body p {
    margin: 0 0 1.8rem;
    color: color-mix(in srgb, var(--paper) 70%, transparent);
    font-size: 1.05rem;
    line-height: 1.65;
  }

  .closing-section__button {
    border-color: var(--paper);
    color: var(--ink);
    background: var(--paper);
  }

  @media (max-width: 980px) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
      min-height: 0;
      padding-block: 5rem;
    }

    .hero__copy {
      max-width: 44rem;
    }

    .product-switcher {
      max-width: 45rem;
    }
  }

  @media (max-width: 760px) {
    .hero {
      padding-block: 3.75rem;
    }

    h1 {
      max-width: 100%;
      font-size: clamp(3.15rem, 13.5vw, 4.6rem);
      overflow-wrap: anywhere;
    }

    h1 span,
    h1 em,
    .hero__body,
    .product-choice__topline span,
    .product-choice__identity h2,
    .product-choice__identity p,
    .product-choice__summary,
    .product-choice__footer span {
      overflow-wrap: anywhere;
    }

    .product-switcher__heading,
    .product-choice__topline,
    .product-choice__footer {
      gap: 0.65rem;
    }

    :global(html[lang="zh-CN"]) h1 {
      font-size: clamp(3.05rem, 13vw, 4.5rem);
      letter-spacing: -0.05em;
      line-height: 0.9;
    }

    .hero__actions {
      align-items: stretch;
      flex-direction: column;
    }

    .independence-section,
    .principles-section {
      padding-block: 5.5rem;
    }

    .independence-section__grid,
    .closing-section__inner {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .principles-grid {
      grid-template-columns: 1fr;
    }

    .principles-grid article,
    .principles-grid article:first-child {
      min-height: 0;
      padding: 1.4rem 1.25rem 2.4rem;
      border-right: 1px solid var(--line-strong);
      border-bottom: 1px solid var(--line-strong);
      border-left: 1px solid var(--line-strong);
    }

    .principle-label {
      margin-top: 3rem;
    }

    .closing-section h2 {
      font-size: clamp(3.2rem, 15vw, 5rem);
    }
  }
</style>
