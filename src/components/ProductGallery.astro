---
import type { Locale, ProductScreenshot } from "../data/products";
import { siteCopy } from "../data/site";

interface Props {
  locale: Locale;
  screenshots: readonly ProductScreenshot[];
}

const { locale, screenshots } = Astro.props;
const text = siteCopy[locale];
---

<section id="interface" class="gallery" aria-labelledby="gallery-title">
  <div class="shell">
    <header class="gallery__heading">
      <div>
        <p class="eyebrow">{text.pageScreensEyebrow}</p>
        <h2 id="gallery-title">{text.pageScreensTitle}</h2>
      </div>
      <div class="gallery__note">
        <span><i aria-hidden="true"></i>{text.pagePreviewData}</span>
        <p>{text.pageScreensBody}</p>
      </div>
    </header>

    <ol class="tour">
      {
        screenshots.map((screenshot, index) => (
          <li class="tour-row">
            <div class="tour-row__text">
              <p class="tour-row__eyebrow">
                <span>{String(index + 1).padStart(2, "0")}</span>
                {screenshot.eyebrow[locale]}
              </p>
              <h3>{screenshot.title[locale]}</h3>
              <p>{screenshot.body[locale]}</p>
            </div>
            <a
              class="gallery-card__image"
              href={screenshot.src[locale]}
              target="_blank"
              rel="noreferrer"
              aria-label={`${text.pageOpenScreenshot}: ${screenshot.title[locale]}`}
            >
              <span class="gallery-card__chrome" aria-hidden="true">
                <i></i><i></i><i></i>
                <b>ViberMate</b>
              </span>
              <img
                src={screenshot.previewSrc[locale]}
                srcset={`${screenshot.previewSrc[locale]} 1280w, ${screenshot.src[locale]} 2400w`}
                sizes="(max-width: 900px) calc(100vw - 1.5rem), min(52rem, calc(66vw - 2.5rem))"
                width={screenshot.width}
                height={screenshot.height}
                alt={screenshot.alt[locale]}
                loading="lazy"
                decoding="async"
              />
              <span class="gallery-card__open" aria-hidden="true">↗</span>
            </a>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .gallery {
    padding-block: clamp(5rem, 10vw, 9rem);
    color: var(--paper);
    background:
      radial-gradient(circle at 82% 12%, color-mix(in srgb, var(--vibermate-blue) 12%, transparent), transparent 28rem),
      var(--ink);
  }

  .gallery__heading {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(18rem, 0.75fr);
    align-items: end;
    gap: clamp(2rem, 8vw, 7rem);
    margin-bottom: clamp(2.5rem, 6vw, 4.5rem);
  }

  .gallery .eyebrow {
    color: var(--vibermate-cyan);
  }

  .gallery h2 {
    max-width: 13ch;
    margin: 0.9rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(2.8rem, 6vw, 5.4rem);
    font-weight: 610;
    letter-spacing: -0.055em;
    line-height: 0.94;
  }

  .gallery__note > span {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--vibermate-cyan);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .gallery__note i {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: currentColor;
    box-shadow: 0 0 0 0.28rem color-mix(in srgb, currentColor 14%, transparent);
  }

  .gallery__note p {
    margin: 0.9rem 0 0;
    color: color-mix(in srgb, var(--paper) 68%, transparent);
    line-height: 1.65;
  }

  .tour {
    display: grid;
    gap: clamp(3.5rem, 8vw, 6.5rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tour-row {
    display: grid;
    grid-template-columns: minmax(15rem, 0.42fr) minmax(0, 1.58fr);
    align-items: center;
    gap: clamp(1.8rem, 5vw, 4.5rem);
  }

  .tour-row:nth-child(even) {
    grid-template-columns: minmax(0, 1.58fr) minmax(15rem, 0.42fr);
  }

  .tour-row:nth-child(even) .tour-row__text {
    order: 2;
  }

  .tour-row__eyebrow {
    display: flex;
    align-items: baseline;
    gap: 0.8rem;
    margin: 0;
    color: var(--vibermate-cyan);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .tour-row__eyebrow span {
    color: color-mix(in srgb, var(--paper) 45%, transparent);
  }

  .tour-row h3 {
    margin: 0.9rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 2.6vw, 2.35rem);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.05;
  }

  .tour-row__text > p:last-child {
    margin: 1rem 0 0;
    color: color-mix(in srgb, var(--paper) 68%, transparent);
    line-height: 1.65;
  }

  .gallery-card__image {
    position: relative;
    display: block;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--paper) 25%, transparent);
    border-radius: 0.8rem;
    color: var(--paper);
    background: #eef3f7;
    box-shadow: 0 1.8rem 5rem color-mix(in srgb, #000 36%, transparent);
    text-decoration: none;
  }

  .gallery-card__image::after {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: inset 0 0 0 1px color-mix(in srgb, #fff 18%, transparent);
    content: "";
    pointer-events: none;
  }

  .gallery-card__chrome {
    display: flex;
    min-height: 2rem;
    align-items: center;
    gap: 0.38rem;
    padding-inline: 0.75rem;
    border-bottom: 1px solid color-mix(in srgb, var(--paper) 15%, transparent);
    background: #14232a;
  }

  .gallery-card__chrome i {
    width: 0.48rem;
    height: 0.48rem;
    border-radius: 50%;
    background: var(--coral);
  }

  .gallery-card__chrome i:nth-child(2) {
    background: var(--beacon);
  }

  .gallery-card__chrome i:nth-child(3) {
    background: var(--vibermate-cyan);
  }

  .gallery-card__chrome b {
    margin-left: auto;
    color: color-mix(in srgb, var(--paper) 60%, transparent);
    font-family: var(--font-mono);
    font-size: 0.55rem;
    font-weight: 400;
    letter-spacing: 0.08em;
  }

  .gallery-card__image img {
    display: block;
    width: 100%;
    height: auto;
  }

  .gallery-card__open {
    position: absolute;
    right: 0.8rem;
    bottom: 0.8rem;
    display: grid;
    width: 2.4rem;
    height: 2.4rem;
    place-items: center;
    border: 1px solid color-mix(in srgb, var(--ink) 20%, transparent);
    border-radius: 50%;
    color: var(--ink);
    background: color-mix(in srgb, var(--surface) 88%, transparent);
    font-family: var(--font-mono);
    opacity: 0;
    transform: translateY(0.35rem);
    transition: opacity 160ms ease, transform 160ms ease;
  }

  .gallery-card__image:hover .gallery-card__open,
  .gallery-card__image:focus-visible .gallery-card__open {
    opacity: 1;
    transform: translateY(0);
  }

  @media (max-width: 900px) {
    .gallery__heading,
    .tour-row,
    .tour-row:nth-child(even) {
      grid-template-columns: 1fr;
    }

    .tour-row:nth-child(even) .tour-row__text {
      order: 0;
    }
  }

  @media (max-width: 760px) {
    .gallery-card__chrome {
      min-height: 1.65rem;
    }

    .gallery-card__open {
      display: none;
    }
  }
</style>
