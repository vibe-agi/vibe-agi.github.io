---
interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<span class:list={["brand-mark", { compact }]} aria-hidden="true">
  <svg viewBox="0 0 64 64" role="img">
    <rect width="64" height="64" rx="17" fill="currentColor" />
    <path d="M13 22h15l7 10h16M13 42h15l7-10h16" />
    <circle cx="35" cy="32" r="5" />
  </svg>
</span>

<style>
  .brand-mark {
    display: inline-flex;
    width: 2.7rem;
    height: 2.7rem;
    color: var(--brand-surface, var(--ink));
    flex: 0 0 auto;
  }

  .brand-mark.compact {
    width: 2.25rem;
    height: 2.25rem;
  }

  svg {
    width: 100%;
    height: 100%;
  }

  path {
    fill: none;
    stroke: var(--current);
    stroke-width: 4;
    stroke-linecap: round;
  }

  circle {
    fill: var(--beacon);
    stroke: var(--ink);
    stroke-width: 2;
  }
</style>
