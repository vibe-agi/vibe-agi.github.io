---
import BrandMark from "./BrandMark.astro";
import { siteCopy } from "../data/site";
import type { Locale } from "../data/products";

interface Props {
  locale: Locale;
  alternateHref: string;
}

const { locale, alternateHref } = Astro.props;
const text = siteCopy[locale];
const home = locale === "zh" ? "/zh/" : "/";
---

<a class="skip-link" href="#content">{text.skip}</a>
<header class="site-header">
  <div class="site-header__inner shell">
    <a class="wordmark" href={home} aria-label="Vibe AGI home">
      <BrandMark compact />
      <span>Vibe AGI</span>
    </a>
    <nav aria-label={locale === "zh" ? "主导航" : "Primary navigation"}>
      <a href={`${home}#products`}>{text.navProducts}</a>
      <a href={`${home}#principles`}>{text.navPrinciples}</a>
      <a href="https://github.com/vibe-agi">{text.navGitHub}<span aria-hidden="true">↗</span></a>
    </nav>
    <a class="language-switch" href={alternateHref} hreflang={locale === "zh" ? "en" : "zh-CN"}>
      <span aria-hidden="true">文/A</span>
      <span>{text.alternateLanguage}</span>
    </a>
  </div>
</header>

<style>
  .skip-link {
    position: fixed;
    z-index: 100;
    top: 0.75rem;
    left: 0.75rem;
    padding: 0.7rem 1rem;
    color: var(--paper);
    background: var(--ink);
    transform: translateY(-180%);
  }

  .skip-link:focus {
    transform: translateY(0);
  }

  .site-header {
    position: sticky;
    z-index: 20;
    top: 0;
    border-bottom: 1px solid color-mix(in srgb, var(--paper) 11%, transparent);
    color: var(--paper);
    background: color-mix(in srgb, var(--matrix) 90%, transparent);
    --brand-surface: #153128;
    backdrop-filter: blur(18px);
  }

  .site-header__inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    min-height: 4.8rem;
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    justify-self: start;
    gap: 0.75rem;
    color: var(--paper);
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 680;
    letter-spacing: -0.02em;
    text-decoration: none;
  }

  nav {
    display: flex;
    align-items: center;
    gap: clamp(1.2rem, 3vw, 2.4rem);
  }

  nav a,
  .language-switch {
    color: color-mix(in srgb, var(--paper) 64%, transparent);
    font-size: 0.9rem;
    font-weight: 620;
    text-decoration: none;
    transition: color 160ms ease;
  }

  nav a:hover,
  .language-switch:hover {
    color: var(--current);
  }

  nav a span {
    margin-left: 0.22rem;
  }

  .language-switch {
    display: inline-flex;
    align-items: center;
    justify-self: end;
    gap: 0.5rem;
    padding: 0.55rem 0.75rem;
    border: 1px solid color-mix(in srgb, var(--paper) 25%, transparent);
    border-radius: 999px;
  }

  .language-switch span:first-child {
    font-family: var(--font-mono);
    font-size: 0.66rem;
  }

  @media (max-width: 720px) {
    .site-header__inner {
      grid-template-columns: 1fr auto;
      min-height: 4.25rem;
    }

    nav {
      display: none;
    }

    .language-switch span:last-child {
      display: none;
    }
  }
</style>
