---
import type { Product } from "../data/products";

interface Props {
  product: Product["slug"];
  size?: "small" | "large";
}

const { product, size = "small" } = Astro.props;
---

<span class:list={["glyph", `glyph--${size}`]} aria-hidden="true">
  {
    product === "vibermate" && (
      <svg viewBox="0 0 32 32">
        <path d="M4 9h8l4 7h12M4 23h8l4-7h12" />
        <circle cx="16" cy="16" r="3" />
      </svg>
    )
  }
  {
    product === "hideout" && (
      <svg viewBox="0 0 32 32">
        <path d="M5 13 16 5l11 8v12H5Z" />
        <path d="M11 25v-8h10v8M9 11l7 5 7-5" />
      </svg>
    )
  }
</span>

<style>
  .glyph {
    display: inline-flex;
    width: 2rem;
    height: 2rem;
    color: inherit;
  }

  .glyph--large {
    width: 3.25rem;
    height: 3.25rem;
  }

  svg {
    width: 100%;
    height: 100%;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  circle,
  ellipse {
    fill: none;
  }
</style>
