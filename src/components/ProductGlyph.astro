---
import type { Product } from "../data/products";

interface Props {
  product: Product["slug"];
  size?: "small" | "large";
}

const { product, size = "small" } = Astro.props;
---

<span class:list={["glyph", `glyph--${size}`, `glyph--${product}`]} aria-hidden="true">
  {
    product === "vibermate" && (
      <img src="/brands/vibermate-app-icon.svg" alt="" width="64" height="64" />
    )
  }
  {
    product === "hideout" && (
      <svg viewBox="0 0 32 32">
        <path d="M5 13 16 5l11 8v12H5Z" />
        <path d="M11 25v-8h10v8M9 11l7 5 7-5" />
      </svg>
    )
  }
</span>

<style>
  .glyph {
    display: inline-flex;
    width: 2rem;
    height: 2rem;
    color: inherit;
  }

  .glyph--large {
    width: 3.75rem;
    height: 3.75rem;
  }

  svg,
  img {
    width: 100%;
    height: 100%;
  }

  img {
    object-fit: contain;
  }

  .glyph--hideout {
    padding: 0.28rem;
    border: 1px solid currentColor;
    border-radius: 0.65rem;
    background: color-mix(in srgb, currentColor 8%, transparent);
  }

  .glyph--hideout svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .glyph--hideout circle,
  .glyph--hideout ellipse {
    fill: none;
  }
</style>
